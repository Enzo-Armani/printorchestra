<file path="app/globals.css">
@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

/* PrintOrchestra Styles */
 .printorchestra-container {
  font-family: var(--font-inter), 'Inter', sans-serif;
  background: #000;
  color: #fff;
  overflow-x: hidden;
  min-height: 100vh;
  position: relative;
  padding-top: 80px; /* offset for fixed navbar */
  background: radial-gradient(ellipse at top, #0a0a0a 0%, #000 50%),
              radial-gradient(ellipse at bottom, #001122 0%, #000 50%);
}

/* Particle Animation Background */
.particle-container {
  position: fixed;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.particle {
  position: absolute;
  width: 2px;
  height: 2px;
  background: rgba(100, 200, 255, 0.5);
  border-radius: 50%;
  animation: float 20s infinite linear;
}

.particle:nth-child(1) { left: 10%; animation-delay: 0s; animation-duration: 25s; }
.particle:nth-child(2) { left: 30%; animation-delay: 5s; animation-duration: 20s; }
.particle:nth-child(3) { left: 50%; animation-delay: 10s; animation-duration: 30s; }
.particle:nth-child(4) { left: 70%; animation-delay: 15s; animation-duration: 22s; }
.particle:nth-child(5) { left: 90%; animation-delay: 20s; animation-duration: 28s; }

@keyframes float {
  0% {
    transform: translateY(100vh) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(-100vh) rotate(360deg);
    opacity: 0;
  }
}

/* Veil Overlay */
.veil-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, 
    rgba(0,0,0,0.3) 0%, 
    rgba(0,0,0,0) 50%, 
    rgba(0,0,0,0.5) 100%);
  pointer-events: none;
  z-index: 2;
}

/* Spotlight Effect */
.spotlight {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 3;
  mix-blend-mode: screen;
  transition: background 0.3s ease;
}

/* Header */
.main-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  padding: 0.75rem 0;
  animation: fadeInDown 1s ease-out;
  transition: background 0.25s ease, border-color 0.25s ease, backdrop-filter 0.25s ease, transform 0.25s ease, opacity 0.25s ease;
}

.header-top {
  background: transparent;
  border-bottom: 1px solid transparent;
  backdrop-filter: none;
}

.header-scrolled {
  background: rgba(0, 0, 0, 0.35);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(8px);
}

.header-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo-container {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.logo-link {
  display: inline-block;
  text-decoration: none;
}

.logo-text {
  font-family: var(--font-space-grotesk), 'Space Grotesk', sans-serif;
  font-size: 1.8rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, #fff 0%, #888 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.logo-accent {
  background: linear-gradient(135deg, #00ffff 0%, #0088ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.logo-tagline {
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  color: #666;
  margin-top: 0.2rem;
  font-weight: 300;
  white-space: nowrap;
}

/* Navbar */
.nav-links {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}

/* Hero-spanning navbar */
.nav-hero {
  width: 100%;
  justify-content: space-between;
  margin: 0 0 2rem 0;
}

/* Top navbar (aligned with logo) */
.nav-top {
  display: flex;
  gap: 0.75rem;
  margin-left: auto;
  justify-content: flex-end;
}

.nav-button {
  position: relative;
  padding: 0.25rem 0.5rem;
  background: none;
  border: none;
  color: #cfe7ff;
  font-weight: 600;
  font-size: 0.95rem;
  letter-spacing: 0.02em;
  cursor: pointer;
  transition: color 0.2s ease, opacity 0.2s ease;
  text-decoration: none;
}

.nav-button:hover,
.nav-button:focus {
  color: #ffffff;
}

.nav-button::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -6px;
  height: 2px;
  background: linear-gradient(90deg, #00ffff 0%, #0088ff 100%);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease, opacity 0.3s ease;
  opacity: 0.8;
}

.nav-button:hover::after,
.nav-button:focus-visible::after,
.nav-button-active::after {
  transform: scaleX(1);
}

.nav-button-active {
  color: #ffffff;
}

/* Hide header when gallery in view */
.header-hidden {
  transform: translateY(-100%);
  opacity: 0;
  pointer-events: none;
}

/* Hero Container */
.hero-container {
  position: relative;
  z-index: 10;
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem;
  min-height: calc(100vh - 200px);
}

/* Split hero layout */
.hero-split {
  display: grid;
  grid-template-columns: minmax(320px, 1.1fr) 1fr;
  gap: 3rem;
  align-items: center;
}

.hero-left .glitch-container {
  text-align: left;
  margin-bottom: 2rem;
}

.hero-right {
  display: flex;
  justify-content: center;
}

.hero-image {
  width: 100%;
  height: auto;
  max-width: 640px;
  border-radius: 8px;
  box-shadow: 0 20px 60px rgba(0, 200, 255, 0.08);
  filter: drop-shadow(0 0 25px rgba(0, 200, 255, 0.12));
}

/* Bottom light gradient in hero */
.hero-bottom-glow {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 45vh;
  background:
    radial-gradient(120% 80% at 50% 100%, rgba(0, 200, 255, 0.20) 0%, rgba(0, 200, 255, 0.10) 35%, rgba(0,0,0,0) 70%),
    linear-gradient(0deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 60%);
  pointer-events: none;
  z-index: 1;
}

/* Glitch Text Effect */
.glitch-container {
  text-align: center;
  margin-bottom: 4rem;
  animation: fadeIn 1.5s ease-out 0.5s backwards;
}

.glitch-subtext {
  font-family: var(--font-space-grotesk), 'Space Grotesk', sans-serif;
  font-size: clamp(1.25rem, 4vw, 2rem);
  font-weight: 500;
  color: #9aa;
  text-transform: none;
  letter-spacing: 0.14em;
  margin: 2rem 0 2rem;
  opacity: 0.9;
}

.glitch-description {
  font-family: var(--font-space-grotesk), 'Space Grotesk', sans-serif;
  font-size: clamp(1rem, 2.4vw, 1.25rem);
  color: #9aa;
  line-height: 1.7;
  max-width: 48ch;
  margin: 2rem 0 0;
  font-weight: 400;
  letter-spacing: 0.02em;
  text-wrap: balance;
}

.glitch-text {
  font-family: var(--font-space-grotesk), 'Space Grotesk', sans-serif;
  font-size: clamp(2.25rem, 6vw, 4.5rem);
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 0.9;
  position: relative;
  text-shadow: 0 0 20px rgba(0, 200, 255, 0.5);
  background: linear-gradient(135deg, #fff 0%, #00ffff 50%, #fff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  background-size: 200% 200%;
  animation: gradientShift 3s ease infinite;
}

@keyframes gradientShift {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}


.glitch-text::before,
.glitch-text::after {
  content: attr(data-text);
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.glitch-text::before {
  animation: glitch-1 0.5s infinite;
  background: linear-gradient(135deg, #ff00ff 0%, #00ffff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  z-index: -1;
}

.glitch-text::after {
  animation: glitch-2 0.5s infinite;
  background: linear-gradient(135deg, #00ff00 0%, #ffff00 100%);
  -webkit-background-clip: text;
  background-clip: text;
  z-index: -2;
}

@keyframes glitch-1 {
  0%, 100% { clip-path: inset(0 0 0 0); transform: translate(0); }
  20% { clip-path: inset(20% 0 30% 0); transform: translate(-2px, 2px); }
  40% { clip-path: inset(50% 0 20% 0); transform: translate(2px, -2px); }
  60% { clip-path: inset(10% 0 60% 0); transform: translate(-1px, 1px); }
  80% { clip-path: inset(80% 0 5% 0); transform: translate(1px, -1px); }
}

@keyframes glitch-2 {
  0%, 100% { clip-path: inset(0 0 0 0); transform: translate(0); }
  20% { clip-path: inset(60% 0 10% 0); transform: translate(2px, -1px); }
  40% { clip-path: inset(20% 0 40% 0); transform: translate(-2px, 1px); }
  60% { clip-path: inset(40% 0 30% 0); transform: translate(1px, 2px); }
  80% { clip-path: inset(10% 0 70% 0); transform: translate(-1px, -2px); }
}

/* Product Reveal Section */
.product-reveal {
  position: relative;
  height: 400px;
  margin: 4rem 0;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: fadeIn 2s ease-out 1s backwards;
}

.product-veil {
  position: relative;
  width: 100%;
  max-width: 800px;
  height: 100%;
}

.veil-fabric {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.8) 10%, rgba(0,0,0,0.8) 90%, transparent 100%),
    linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.9) 20%, rgba(0,0,0,0.9) 80%, transparent 100%);
  filter: blur(20px);
}

.product-silhouette {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600px;
  height: 300px;
  background: 
    radial-gradient(ellipse at center, rgba(0, 100, 200, 0.1) 0%, transparent 50%);
  filter: blur(10px);
  animation: pulse 3s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 0.8; transform: translate(-50%, -50%) scale(1.05); }
}

.reveal-section {
  position: absolute;
  cursor: pointer;
  transition: all 0.3s ease;
}

.reveal-section:hover .reveal-glow {
  opacity: 1;
  transform: scale(1.5);
}

.reveal-section:hover .feature-hint {
  opacity: 1;
  transform: translateY(-10px);
}

.arm-hint {
  top: 20%;
  right: 15%;
}

.printer-hint {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.system-hint {
  bottom: 20%;
  left: 20%;
}

.reveal-glow {
  width: 80px;
  height: 80px;
  background: radial-gradient(circle, rgba(0, 200, 255, 0.6) 0%, transparent 70%);
  border-radius: 50%;
  opacity: 0.3;
  transition: all 0.3s ease;
  animation: glow 2s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% { box-shadow: 0 0 20px rgba(0, 200, 255, 0.4); }
  50% { box-shadow: 0 0 40px rgba(0, 200, 255, 0.8); }
}

.feature-hint {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  color: #00ffff;
  opacity: 0;
  transition: all 0.3s ease;
  white-space: nowrap;
  font-weight: 300;
  text-shadow: 0 0 10px rgba(0, 255, 255, 0.8);
}

/* Features Grid */
.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  margin: 4rem 0;
}

.feature-card {
  background: linear-gradient(135deg, rgba(0,20,40,0.5) 0%, rgba(0,10,20,0.3) 100%);
  border: 1px solid rgba(0, 200, 255, 0.1);
  padding: 2rem;
  border-radius: 10px;
  text-align: center;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
  opacity: 0;
  transform: translateY(30px);
}

.feature-card.revealed {
  animation: revealCard 0.6s ease-out forwards;
}

.feature-card[data-reveal="1"].revealed { animation-delay: 0.1s; }
.feature-card[data-reveal="2"].revealed { animation-delay: 0.2s; }
.feature-card[data-reveal="3"].revealed { animation-delay: 0.3s; }
.feature-card[data-reveal="4"].revealed { animation-delay: 0.4s; }

@keyframes revealCard {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.feature-card:hover {
  background: linear-gradient(135deg, rgba(0,30,60,0.6) 0%, rgba(0,15,30,0.4) 100%);
  border-color: rgba(0, 200, 255, 0.3);
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(0, 200, 255, 0.2);
}

.feature-icon {
  font-size: 2rem;
  color: #00ffff;
  margin-bottom: 1rem;
  filter: drop-shadow(0 0 10px rgba(0, 255, 255, 0.5));
}

.feature-card h3 {
  font-size: 1.1rem;
  margin-bottom: 0.5rem;
  font-weight: 600;
  background: linear-gradient(135deg, #fff 0%, #00ffff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.feature-card p {
  font-size: 0.9rem;
  color: #888;
  font-weight: 300;
}

/* Countdown Section */
.coming-soon {
  text-align: center;
  margin: 4rem 0;
  animation: fadeIn 2s ease-out 1.5s backwards;
}

.countdown-label {
  font-size: 0.8rem;
  letter-spacing: 0.3em;
  color: #666;
  margin-bottom: 1rem;
  font-weight: 300;
}

.countdown-container {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.countdown-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80px;
}

.countdown-number {
  font-family: var(--font-space-grotesk), 'Space Grotesk', sans-serif;
  font-size: 3rem;
  font-weight: 700;
  background: linear-gradient(135deg, #fff 0%, #00ffff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 0 0 30px rgba(0, 200, 255, 0.5);
  line-height: 1;
}

.countdown-unit {
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  color: #666;
  margin-top: 0.5rem;
  font-weight: 300;
}

.countdown-separator {
  font-size: 2rem;
  color: #333;
  animation: blink 2s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* Notify Section */
.notify-section {
  max-width: 600px;
  margin: 4rem auto;
  text-align: center;
  animation: fadeIn 2s ease-out 2s backwards;
}

.notify-text {
  font-size: 1.1rem;
  color: #888;
  margin-bottom: 2rem;
  font-weight: 300;
}

.notify-form {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.email-input {
  flex: 1;
  min-width: 250px;
  padding: 1rem 1.5rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(0, 200, 255, 0.2);
  border-radius: 50px;
  color: #fff;
  font-size: 1rem;
  outline: none;
  transition: all 0.3s ease;
}

.email-input::placeholder {
  color: #666;
}

.email-input:focus {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(0, 200, 255, 0.5);
  box-shadow: 0 0 20px rgba(0, 200, 255, 0.2);
}

.notify-button {
  padding: 1rem 2rem;
  background: linear-gradient(135deg, #0088ff 0%, #00ffff 100%);
  border: none;
  border-radius: 50px;
  color: #000;
  font-weight: 600;
  font-size: 0.9rem;
  letter-spacing: 0.05em;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.notify-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(0, 200, 255, 0.4);
}

.arrow-icon {
  transition: transform 0.3s ease;
}

.notify-button:hover .arrow-icon {
  transform: translateX(5px);
}

/* Teaser Text */
.teaser-text {
  text-align: center;
  margin: 4rem 0;
  animation: fadeIn 2s ease-out 2.5s backwards;
}

.teaser-text p {
  font-size: 1.2rem;
  color: #666;
  margin: 0.5rem 0;
  font-weight: 300;
  font-style: italic;
}

/* AI OS Section */
.ai-section {
  position: relative;
  z-index: 10;
  max-width: 1400px;
  margin: 6rem auto;
  padding: 0 2rem;
  text-align: center;
}

/* Tighter spacing for gallery heading */
.gallery-heading.ai-section {
  margin: 1rem auto 1rem; /* add space below heading */
  padding-bottom: 0;
}

.ai-heading {
  font-family: 'Avenir Next', 'AvenirNext', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: clamp(4rem, 10vw, 4.8rem); /* doubled */
  font-weight: 700;
  background: linear-gradient(135deg, #fff 0%, #00ffff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.5rem;
}

.ai-paragraph {
  color: #888;
  font-weight: 300;
  font-size: clamp(1.125rem, 2.8vw, 1.4rem);
  max-width: 900px;
  margin: 0 auto 2rem;
}

.ai-image {
  width: 100%;
  height: auto;
  max-width: 1100px;
  display: block;
  margin: 0 auto;
  border-radius: 18px;
  box-shadow: 0 25px 60px rgba(0, 200, 255, 0.14), 0 8px 24px rgba(0, 0, 0, 0.35);
}

/* Sections */
.content-section {
  position: relative;
  z-index: 10;
  max-width: 1100px;
  margin: 6rem auto;
  padding: 3rem 2rem;
  background: linear-gradient(135deg, rgba(0,20,40,0.5) 0%, rgba(0,10,20,0.3) 100%);
  border: 1px solid rgba(0, 200, 255, 0.12);
  border-radius: 20px;
  backdrop-filter: blur(10px);
  box-shadow: 0 20px 50px rgba(0, 200, 255, 0.08);
  scroll-margin-top: 120px;
}

/* White title for option sections */
.content-section .section-title {
  font-family: 'Avenir Next', 'AvenirNext', Avenir, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: clamp(4rem, 10vw, 4.8rem); /* match AI heading sizing */
  font-weight: 700; /* match AI heading weight */
  margin-bottom: 0.75rem;
  color: #fff;
  background: none !important;
  -webkit-background-clip: initial !important;
  -webkit-text-fill-color: initial !important;
}

.section-title-main { font-weight: inherit; }
.section-title-sub {
  font-weight: 600;
  font-size: 0.5em; /* half of main */
  letter-spacing: 0.01em;
  opacity: 0.95;
  color: #c0c7d1;
  display: block;
  margin-top: 0.25rem;
  font-style: italic;
}

.content-section p {
  color: #c0c7d1;
  font-weight: 300;
  line-height: 1.7;
}

/* Per-section color theming */
#option1.content-section {
  background: linear-gradient(90deg, rgba(88, 28, 135, 0.20) 0%, rgba(131, 24, 67, 0.20) 100%);
  border-color: rgba(168, 85, 247, 0.30);
}

#option2.content-section {
  background: linear-gradient(90deg, rgba(29, 78, 216, 0.20) 0%, rgba(88, 28, 135, 0.20) 100%);
  border-color: rgba(59, 130, 246, 0.30);
}

#option3.content-section {
  background: linear-gradient(90deg, rgba(190, 24, 93, 0.20) 0%, rgba(153, 27, 27, 0.20) 100%);
  border-color: rgba(236, 72, 153, 0.30);
}

/* Metrics list (Option sections) */
.metrics-list {
  margin-top: 1.25rem;
}

.metric-item {
  display: flex;
  align-items: center;
  gap: 1.75rem;
  padding: 0.95rem 0;
}

.metric-item--with-breakdown {
  flex-direction: column;
  align-items: stretch;
}

.metric-row-header {
  display: flex;
  align-items: center;
}

.metric-row-header .metric-label {
  margin-right: 1.75rem; /* same visual gap as other rows */
}

.metric-row-header .metric-value {
  margin-left: auto; /* right-align value like other metric rows */
}
.metric-item:not(:last-child) {
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.metric-icon {
  font-size: 2.4rem;
  width: 3rem;
  text-align: center;
  filter: drop-shadow(0 3px 15px rgba(0, 200, 255, 0.25));
}

.metric-label {
  color: #d5dbe6;
  font-weight: 700;
  font-size: 1.5rem;
}

.metric-value {
  margin-left: auto;
  color: #eef3fb;
  font-weight: 800;
  font-size: 1.75rem;
}

.metric-value-toggle {
  background: none;
  border: none;
  padding: 0;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  cursor: pointer;
  color: inherit;
}

.metric-toggle-arrow {
  font-size: 1.5em; /* ~50% larger than text */
  color: #10b981; /* match green of Kunden-ROI pill */
  display: inline-block;
  transition: transform 0.2s ease;
}

.metric-toggle-arrow.is-open {
  transform: rotate(180deg);
}

.metric-breakdown {
  width: 100%;
  margin-top: 0.5rem;
  padding-right: calc(3rem + 1.75rem); /* indent from right side instead of left */
  color: #d5dbe6;
  font-weight: 400;
  font-size: 1rem;
  display: flex;
  flex-direction: column;
  align-items: flex-end; /* move lines towards the right */
  gap: 0.15rem;
  text-align: right;
}

.metric-breakdown-line {
  width: 100%;
}

.pill {
  margin-left: auto;
  padding: 0.55rem 1.25rem;
  border-radius: 9999px;
  font-weight: 800;
  color: #fff;
  font-size: 1.5rem;
  box-shadow: 0 12px 32px rgba(0, 200, 255, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.16);
}
.pill--purple {
  background: linear-gradient(90deg, #6a5cff 0%, #7c4dff 100%);
}
.pill--green {
  background: linear-gradient(90deg, #1dd1a1 0%, #10b981 100%);
}

/* Footer */
.main-footer {
  position: relative;
  z-index: 10;
  padding: 1rem; /* reduced by 50% */
  text-align: center;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  animation: fadeIn 2s ease-out 3s backwards;
}

.footer-content {
  font-size: 0.8rem;
  color: #444;
  letter-spacing: 0.05em;
}

.separator {
  margin: 0 1rem;
  color: #333;
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Responsive Design */
@media (max-width: 1024px) {
  .hero-split {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .hero-right { order: 2; }
  .hero-left { order: 1; }
  .nav-align { padding: 0 1.5rem; }
  .glitch-description { max-width: 44ch; }
}

@media (min-width: 1024px) and (max-width: 1200px) {
  .glitch-description { max-width: 46ch; }
}

@media (min-width: 1200px) and (max-width: 1440px) {
  .glitch-description { max-width: 48ch; }
}

@media (min-width: 1440px) {
  .glitch-description { max-width: 50ch; }
}

@media (max-width: 768px) {
  .main-header {
    padding: 0.5rem 0;
  }

  .printorchestra-container {
    padding-top: 96px; /* slightly larger offset on mobile */
  }

  .hero-bottom-glow {
    height: 30vh;
    background:
      radial-gradient(140% 90% at 50% 100%, rgba(0, 200, 255, 0.18) 0%, rgba(0, 200, 255, 0.08) 35%, rgba(0,0,0,0) 70%),
      linear-gradient(0deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 60%);
  }

  .header-inner {
    padding: 0 1.5rem;
    gap: 0.75rem;
  }

  .nav-links {
    flex-wrap: wrap;
  }

  .nav-hero {
    justify-content: center;
    gap: 0.75rem;
  }

  .nav-top {
    justify-content: center;
    gap: 0.75rem;
  }

  .nav-button {
    padding: 0.5rem 0.25rem;
    font-size: 0.9rem;
  }

  .logo-text {
    font-size: 1.5rem;
  }
  
  .glitch-text {
    font-size: clamp(1.5rem, 7.5vw, 3rem);
  }
  
  .features-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

@media (max-width: 480px) {
  .countdown-container {
    gap: 0.5rem;
  }
  
  .countdown-item {
    min-width: 60px;
  }
  
  .countdown-number {
    font-size: 1.5rem;
  }
  
  .teaser-text p {
    font-size: 1rem;
  }
}

/* Carousel */
.carousel-section {
  position: relative;
  z-index: 10;
  width: min(96vw, 1400px);
  max-width: 1400px;
  margin: 1rem auto 2rem; /* padding-like space between heading and carousel */
  padding: 0 1rem;
}

.carousel {
  position: relative;
  border-radius: 16px;
  border: 1px solid rgba(0, 200, 255, 0.12);
  background: linear-gradient(135deg, rgba(0,20,40,0.5) 0%, rgba(0,10,20,0.3) 100%);
  box-shadow: 0 20px 50px rgba(0, 200, 255, 0.08);
  overflow: hidden;
}

.carousel-stage {
  position: relative;
  width: 100%;
  /* Taller and more immersive; avoids cropping using object-fit: contain */
  height: clamp(560px, 85vh, 1100px);
}

.carousel-img {
  object-fit: contain;
  transition: opacity 300ms ease;
}

.carousel-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 42px;
  height: 42px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(0,0,0,0.35);
  color: #fff;
  display: grid;
  place-items: center;
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
  z-index: 2;
  transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.carousel-nav:hover {
  background: rgba(0,0,0,0.55);
  box-shadow: 0 6px 18px rgba(0, 200, 255, 0.25);
}

.carousel-nav--left { left: 12px; }
.carousel-nav--right { right: 12px; }

.carousel-dots {
  position: absolute;
  bottom: 10px;
  left: 0;
  right: 0;
  display: flex;
  gap: 6px;
  justify-content: flex-start;
  padding: 10px 12px;
  overflow-x: auto; /* allow many dots */
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
}

.carousel-dots::-webkit-scrollbar { height: 4px; }
.carousel-dots::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.25); border-radius: 999px; }

.carousel-dot {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: rgba(255,255,255,0.35);
  border: 1px solid rgba(255,255,255,0.25);
  cursor: pointer;
  flex: 0 0 auto; /* don’t shrink */
}

.carousel-dot.is-active {
  background: #00d5ff;
  box-shadow: 0 0 12px rgba(0, 200, 255, 0.8);
}


@media (max-width: 640px) {
  .carousel-stage { height: clamp(360px, 70vh, 760px); }
  .carousel-nav { width: 36px; height: 36px; font-size: 24px; }
}
</file>

